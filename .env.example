# Postgres (local docker-compose dev DB)
POSTGRES_USER=homestead
POSTGRES_PASSWORD=change-me
POSTGRES_DB=homestead

# App
# Local dev (compose): points at the `db` service
DATABASE_URL=postgres://homestead:change-me@db:5432/homestead?sslmode=disable

# Managed (Neon/Supabase/AWS) example:
# DATABASE_URL=postgres://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require

# API key required by POST /shorten (sent as the X-API-Key header)
API_KEY=change-me
